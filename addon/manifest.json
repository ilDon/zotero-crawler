{
  "manifest_version": 2,
  "name": "Journal Crawler",
  "version": "0.1.5",
  "description": "Downloads the articles of a list of open access journals (PDF and metadata) into the Zotero library, incrementally.",
  "author": "Gherardo Carullo",
  "homepage_url": "https://github.com/ilDon/zotero-crawler",
  "icons": {
    "48": "content/icons/crawler.svg",
    "96": "content/icons/crawler.svg"
  },
  "applications": {
    "zotero": {
      "id": "journal-crawler@ildon.github.io",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*",
      "update_url": "https://github.com/ilDon/zotero-crawler/releases/latest/download/updates.json"
    }
  }
}
